.DS_Store
__pycache__/
.pytest_cache/
.ruff_cache/
/.cache/

# Keep previously versioned small inputs/research artifacts visible after moving them.
# COCO downloads, validation samples, generated runs, caches, and model weights stay local.
/data/**
!/data/fairness/
!/data/fairness/records.json
!/data/fairness/fairness.sqlite3
!/data/fairness/images/
!/data/fairness/images/*.jpg
!/data/research/
!/data/research/cache/
!/data/research/cache/*
!/data/research/outputs/
!/data/research/outputs/**
!/data/validation/
!/data/validation/examples/
!/data/validation/examples/*
