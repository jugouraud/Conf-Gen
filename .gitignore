.DS_Store
__pycache__/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
/tests/logs/
/.cache/
/.venv/
/.tools/
/archive/.cache/
/archive/.venv/
/archive/.pytest_cache/
/archive/.ruff_cache/

# Keep the prompt benchmark input and previously versioned research artifacts visible.
# Generated datasets, model weights, and the archived environment stay local.
/data/**
!/data/validation/
!/data/validation/i2p_benchmark.csv
/archive/data/**
!/archive/data/research/
!/archive/data/research/cache/
!/archive/data/research/cache/*
!/archive/data/validation/
!/archive/data/validation/i2p_benchmark.csv

# Track experiment runners, settings, and the three review documents. Retained
# tensors, images, transfer bundles, and historical runtime artifacts stay local.
/backend/experiments/**
!/backend/experiments/**/
!/backend/experiments/__init__.py
!/backend/experiments/README.md
!/backend/experiments/migration.json
!/backend/experiments/*/__init__.py
!/backend/experiments/*/pipeline.py
!/backend/experiments/*/*.py
!/backend/experiments/*/config.toml
!/backend/experiments/*/README.md
!/backend/experiments/*/RESULTS.md
!/backend/experiments/*/ANALYSIS.md
!/backend/experiments/conformal_mpc/example_run/frozen_policy.json
!/backend/experiments/conformal_mpc/example_run/output_calibration.json
!/backend/experiments/conformal_mpc/example_run/evaluation.json
!/backend/experiments/conformal_mpc/example_run/report.json
!/backend/experiments/expert_trajectories/bicycle.toml
!/backend/experiments/expert_trajectories/user_scenes.json
!/backend/experiments/expert_trajectories/example_dataset/**/*.json
!/backend/experiments/expert_trajectories/example_dataset/**/*.jsonl
!/backend/experiments/expert_trajectories/bicycle_dataset/**/*.json
!/backend/experiments/expert_trajectories/bicycle_dataset/**/*.jsonl
