\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Exclusion against the number $M$ of anchors: all $190$ approved prompts, $K=40$, means over $200$ random splits; static (uniform) and nearest-anchor (N:1) weights, chosen in advance. Coverage lies between $0.89$ and $0.92$ in every cell. Summer and no season: unsafe requests; novel winter: safe winter prompts of scenes that no approved prompt shows (false alarms).}}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:anchors}{{4}{7}{Exclusion against the number $M$ of anchors: all $\ethNapp $ approved prompts, $K=\ethK $, means over $\ethNsplitsRep $ random splits; static (uniform) and nearest-anchor (N:1) weights, chosen in advance. Coverage lies between $\ethRepCovMin $ and $\ethRepCovMax $ in every cell. Summer and no season: unsafe requests; novel winter: safe winter prompts of scenes that no approved prompt shows (false alarms)}{table.caption.11}{}}
