\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces What the model generates without a region: two prompts of each kind, three probe noises each, with the judge's probability of winter (red: judged unsafe).}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:requests}{{1}{4}{What the model generates without a region: two prompts of each kind, three probe noises each, with the judge's probability of winter (red: judged unsafe)}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Static and adaptive regions. Coverage of approved test prompts (nominal $0.902$) and exclusion of each kind of request: means over $200$ evaluation splits. Enforcement (first split, $8$ requests of each kind, $8$ evaluation noises each): fraction of the deployed images judged unsafe, fraction of the $6$ approved test prompts whose field is altered, and the judge's similarity between the deployed images of the summer, neutral and disguised requests and their scene. Adaptive weights: N:$k$, the $k$ nearest anchors; K:$c$, Gaussian kernel of bandwidth $c$ times the median anchor distance. Mahalanobis: $\rho =10^{-4}$; truncation: $r=0.75$. The $L^2$ field region with adaptive weights is not enforced: its tuned kernel gives nearly uniform weights (effective number of anchors $29.6$ of $30$).}}{4}{table.caption.7}\protected@file@percent }
\newlabel{tab:summary}{{2}{4}{Static and adaptive regions. Coverage of approved test prompts (nominal $\ethNom $) and exclusion of each kind of request: means over $\ethNeval $ evaluation splits. Enforcement (first split, $\ethNreqKind $ requests of each kind, $\ethP $ evaluation noises each): fraction of the deployed images judged unsafe, fraction of the $\ethNreqApp $ approved test prompts whose field is altered, and the judge's similarity between the deployed images of the summer, neutral and disguised requests and their scene. Adaptive weights: N:$k$, the $k$ nearest anchors; K:$c$, Gaussian kernel of bandwidth $c$ times the median anchor distance. Mahalanobis: $\rho =\ethRhoMH $; truncation: $r=\ethRTR $. The $L^2$ field region with adaptive weights is not enforced: its tuned kernel gives nearly uniform weights (effective number of anchors $\ethNeffLtA $ of $\ethM $)}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Fraction of the requests of each kind excluded, static (orange) against adaptive (blue) weights, for the five regions; dashed: fraction of approved test prompts excluded ($1-$coverage). Means over $200$ evaluation splits.}}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:detection}{{2}{5}{Fraction of the requests of each kind excluded, static (orange) against adaptive (blue) weights, for the five regions; dashed: fraction of approved test prompts excluded ($1-$coverage). Means over $\ethNeval $ evaluation splits}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Each request of the evaluation pool: fraction of the $200$ splits in which the static region excludes it, against the judge's mean probability of winter for its own images. Requests to the left of the dashed line are unsafe. Marker: kind of request (filled circle, summer; filled triangle, season not mentioned; hollow diamond, disguised; hollow square, safe unfamiliar request, see Section~\ref {sec:spaces}).}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:per_request}{{3}{5}{Each request of the evaluation pool: fraction of the $\ethNeval $ splits in which the static region excludes it, against the judge's mean probability of winter for its own images. Requests to the left of the dashed line are unsafe. Marker: kind of request (filled circle, summer; filled triangle, season not mentioned; hollow diamond, disguised; hollow square, safe unfamiliar request, see Section~\ref {sec:spaces})}{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Safe but unfamiliar requests: fraction excluded, means over the $200$ evaluation splits of Table~\ref {tab:summary}. Paraphrase: winter prompts of the approved scenes with winter modifiers that no approved prompt uses ($16$ requests); novel winter and novel summer: approved and summer modifiers on $6$ scenes that no approved prompt shows ($12$ and $12$ requests). Excluding a safe request is a false alarm; the summer column repeats Table~\ref {tab:summary}.}}{6}{table.caption.10}\protected@file@percent }
\newlabel{tab:unfamiliar}{{3}{6}{Safe but unfamiliar requests: fraction excluded, means over the $\ethNeval $ evaluation splits of Table~\ref {tab:summary}. Paraphrase: winter prompts of the approved scenes with winter modifiers that no approved prompt uses ($\ethNPar $ requests); novel winter and novel summer: approved and summer modifiers on $6$ scenes that no approved prompt shows ($\ethNNovW $ and $\ethNNovS $ requests). Excluding a safe request is a false alarm; the summer column repeats Table~\ref {tab:summary}}{table.caption.10}{}}
