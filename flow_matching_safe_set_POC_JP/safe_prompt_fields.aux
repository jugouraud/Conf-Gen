\@writefile{toc}{\contentsline {paragraph}{The unsafe set in the source slice, as a decision: the best detector of this note.}{66}{section*.133}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The unsafe set in the prompt and field spaces, as a decision: unusable unless both histories cover every scene.}{66}{section*.134}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Slice, two sets (repair): a calibrated depth for every request that the unsafe set recognises.}{67}{section*.135}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Slice$\to $field, two sets (repair): the best repair of this section.}{67}{section*.136}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Field, two sets, and field, safe set (repairs): the field alone repairs less safely, and refuses new scenes.}{67}{section*.137}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Prompt, two sets: it judges the wording.}{67}{section*.138}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Prompt-adaptive weights: they localise each set on the request's scene, and need anchors of both classes there.}{67}{section*.139}\protected@file@percent }
