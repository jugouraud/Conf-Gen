\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Standard flow matching against reflow on the ring of Section~\ref {sec:evidence}, with the exact marginal velocity. (a) Training pairs of standard flow matching: $60$ noises (grey) paired with independent target samples (blue). (b) Trajectories of the field learned from such pairs, from the same noises. (c) Reflow pairs: the same noises paired with the outputs of (b). (d) Conditional variance of the direction $\mathbf  {u}=\mathbf  {x}_1-\mathbf  {x}_0$ of the pairs given the point $\mathbf  {x}_t$, against $t$: exact for the independent pairs, and a $25$-nearest-neighbour estimate on $20{,}000$ pairs for both couplings; its average over $t$ is the smallest flow-matching loss (Lemma~\ref {lem:reflow}(i)).}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:reflow}{{1}{9}{Standard flow matching against reflow on the ring of Section~\ref {sec:evidence}, with the exact marginal velocity. (a) Training pairs of standard flow matching: $60$ noises (grey) paired with independent target samples (blue). (b) Trajectories of the field learned from such pairs, from the same noises. (c) Reflow pairs: the same noises paired with the outputs of (b). (d) Conditional variance of the direction $\bu =\bx _1-\bx _0$ of the pairs given the point $\bx _t$, against $t$: exact for the independent pairs, and a $25$-nearest-neighbour estimate on $20{,}000$ pairs for both couplings; its average over $t$ is the smallest flow-matching loss (Lemma~\ref {lem:reflow}(i))}{figure.caption.13}{}}
