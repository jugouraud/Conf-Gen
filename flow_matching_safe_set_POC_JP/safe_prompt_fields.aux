\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Detection: what each region admits and excludes (evaluation pool, $M=30$ anchors, $K=40$ calibration prompts, means over $200$ random splits). Each row is one region with static or adaptive weights; the adaptive weights chosen on the tuning pool are named in parentheses (N:$k$: equal weights on the $k$ nearest anchors; K:$c$: Gaussian kernel whose bandwidth is $c$ times the median distance between anchors). \emph  {Coverage}: fraction of the approved test prompts admitted (nominal $0.902$). Every other column is the fraction of the requests of one kind that the region excludes: first the three unsafe kinds, for which higher is better; then the two safe unfamiliar kinds, for which lower is better (false alarms); last the disguised requests, summer prompts followed by ``snowy winter cold'', whose own images are judged unsafe in $0.35$ of the cases, so that neither direction is right for all of them. Mahalanobis: $\rho =10^{-4}$; truncation: $r=0.75$.}}{34}{table.caption.76}\protected@file@percent }
\newlabel{tab:e3_detection}{{12}{34}{Detection: what each region admits and excludes (evaluation pool, $M=\ethM $ anchors, $K=\ethK $ calibration prompts, means over $\ethNeval $ random splits). Each row is one region with static or adaptive weights; the adaptive weights chosen on the tuning pool are named in parentheses (N:$k$: equal weights on the $k$ nearest anchors; K:$c$: Gaussian kernel whose bandwidth is $c$ times the median distance between anchors). \emph {Coverage}: fraction of the approved test prompts admitted (nominal $\ethNom $). Every other column is the fraction of the requests of one kind that the region excludes: first the three unsafe kinds, for which higher is better; then the two safe unfamiliar kinds, for which lower is better (false alarms); last the disguised requests, summer prompts followed by ``snowy winter cold'', whose own images are judged unsafe in $\ethOwnUnsafeDis $ of the cases, so that neither direction is right for all of them. Mahalanobis: $\rho =\ethRhoMH $; truncation: $r=\ethRTR $}{table.caption.76}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces What the model generates without a region. Each row is one kind of request: from top to bottom, approved (winter), season not mentioned, summer, and summer with winter words appended (disguised). Each row shows two prompts, whose text is written above their three images; the three images of a prompt come from the same three probe noises for every prompt. The label in the lower left corner of each image is the judge's probability that the image shows a winter scene; a red label marks an image judged unsafe (probability below $0.5$).}}{35}{figure.caption.75}\protected@file@percent }
\newlabel{fig:e3_requests}{{17}{35}{What the model generates without a region. Each row is one kind of request: from top to bottom, approved (winter), season not mentioned, summer, and summer with winter words appended (disguised). Each row shows two prompts, whose text is written above their three images; the three images of a prompt come from the same three probe noises for every prompt. The label in the lower left corner of each image is the judge's probability that the image shows a winter scene; a red label marks an image judged unsafe (probability below $0.5$)}{figure.caption.75}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Detection map ($M=30$ anchors, means over $200$ evaluation splits; the numbers are those of Table~\ref {tab:e3_detection}). Each point is one region with one weighting. Its colour gives the region, and the two field regions, which share the colour blue, differ by their shape (square: $L^2$; circle: truncated). A hollow ring marks static weights and a small filled dot adaptive weights; a dot inside a ring means that both weightings give the same point. Horizontal axis: the fraction of the $28$ safe unfamiliar requests (paraphrases and novel winter scenes) that the region excludes, that is, its false alarms on safe prompts unlike the approved ones. Vertical axis: the fraction of the unsafe requests excluded, (a) for the summer requests and (b) for the requests that do not mention the season. The ideal region sits in the upper left corner: it excludes every unsafe request and no safe one. Dotted line: the fraction of ordinary approved test prompts excluded, $1-$coverage $\approx 0.10$, which calibration fixes for every region; a region on that line or to its left treats unfamiliar safe prompts as it treats familiar ones.}}{36}{figure.caption.77}\protected@file@percent }
\newlabel{fig:e3_detection}{{18}{36}{Detection map ($M=\ethM $ anchors, means over $\ethNeval $ evaluation splits; the numbers are those of Table~\ref {tab:e3_detection}). Each point is one region with one weighting. Its colour gives the region, and the two field regions, which share the colour blue, differ by their shape (square: $L^2$; circle: truncated). A hollow ring marks static weights and a small filled dot adaptive weights; a dot inside a ring means that both weightings give the same point. Horizontal axis: the fraction of the $\ethNsafeUnf $ safe unfamiliar requests (paraphrases and novel winter scenes) that the region excludes, that is, its false alarms on safe prompts unlike the approved ones. Vertical axis: the fraction of the unsafe requests excluded, (a) for the summer requests and (b) for the requests that do not mention the season. The ideal region sits in the upper left corner: it excludes every unsafe request and no safe one. Dotted line: the fraction of ordinary approved test prompts excluded, $1-$coverage $\approx \ethFAApp $, which calibration fixes for every region; a region on that line or to its left treats unfamiliar safe prompts as it treats familiar ones}{figure.caption.77}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {11.4}What each distance sees (Q3)}{36}{subsection.11.4}\protected@file@percent }
\newlabel{sec:e3_spaces}{{11.4}{36}{What each distance sees (Q3)}{subsection.11.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Does a region judge what is generated? Each panel is one region with static weights, and each point one request of the evaluation pool. Horizontal axis: the judge's mean probability of winter for the request's own images (to the left of the dashed line the images are unsafe, to its right they are safe). Vertical axis: the fraction of the $200$ splits in which the region excludes the request. The marker gives the kind of request: filled circle, summer; filled triangle, season not mentioned; hollow diamond, disguised (summer with winter words); hollow square, safe unfamiliar (paraphrase or novel winter scene). A region that judges the images places the points on the left high and the points on the right low. The Mahalanobis region places every point at the top; the prompt region places most unsafe requests low and some safe unfamiliar ones high; the source slice comes closest to the ideal.}}{37}{figure.caption.78}\protected@file@percent }
\newlabel{fig:e3_per_request}{{19}{37}{Does a region judge what is generated? Each panel is one region with static weights, and each point one request of the evaluation pool. Horizontal axis: the judge's mean probability of winter for the request's own images (to the left of the dashed line the images are unsafe, to its right they are safe). Vertical axis: the fraction of the $\ethNeval $ splits in which the region excludes the request. The marker gives the kind of request: filled circle, summer; filled triangle, season not mentioned; hollow diamond, disguised (summer with winter words); hollow square, safe unfamiliar (paraphrase or novel winter scene). A region that judges the images places the points on the left high and the points on the right low. The Mahalanobis region places every point at the top; the prompt region places most unsafe requests low and some safe unfamiliar ones high; the source slice comes closest to the ideal}{figure.caption.78}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {11.5}More anchors for adaptive weights}{37}{subsection.11.5}\protected@file@percent }
\newlabel{sec:e3_anchors}{{11.5}{37}{More anchors for adaptive weights}{subsection.11.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Exclusion against the number $M$ of anchors (all $190$ approved prompts, $K=40$, means over $200$ random splits for each $M$). Each panel is one kind of request: (a) summer and (b) season not mentioned are unsafe, so higher is better; (c) novel winter scenes are safe, so the curve is a false-alarm rate and lower is better. Colour: the region (prompt, source slice, truncated field; the $L^2$ field region stays within $0.08$ of the truncated one and is omitted). Dashed lines with hollow markers: static weights; solid lines with filled markers: all the weight on the nearest anchor. In (a) the two source-slice curves coincide at $1$. Dotted line in (c): the fraction of ordinary approved test prompts excluded ($1-$coverage).}}{38}{figure.caption.79}\protected@file@percent }
\newlabel{fig:e3_anchors}{{20}{38}{Exclusion against the number $M$ of anchors (all $\ethNapp $ approved prompts, $K=\ethK $, means over $\ethNsplitsRep $ random splits for each $M$). Each panel is one kind of request: (a) summer and (b) season not mentioned are unsafe, so higher is better; (c) novel winter scenes are safe, so the curve is a false-alarm rate and lower is better. Colour: the region (prompt, source slice, truncated field; the $L^2$ field region stays within $\ethAncLtTRdiff $ of the truncated one and is omitted). Dashed lines with hollow markers: static weights; solid lines with filled markers: all the weight on the nearest anchor. In (a) the two source-slice curves coincide at $1$. Dotted line in (c): the fraction of ordinary approved test prompts excluded ($1-$coverage)}{figure.caption.79}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {11.6}Enforcement and certificates (Q4)}{38}{subsection.11.6}\protected@file@percent }
\newlabel{sec:e3_enforce}{{11.6}{38}{Enforcement and certificates (Q4)}{subsection.11.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Enforcement on the first evaluation split ($8$ requests of each kind, $8$ evaluation noises each). Each row is one region with static or adaptive weights; ``no region'' serves every request as asked. For the summer requests and for the requests without season, three columns: the fraction of requests that the region alters (that is, backs off, $\kappa >0$); their mean mixing weight $\kappa $, from $0$ (request unchanged) to $1$ (request replaced by its target), with ``--'' when no request is altered; and the fraction of their deployed images that the judge finds unsafe (lower is better). Then: the fraction of the disguised requests' deployed images judged unsafe; the mean scene similarity of the deployed images of the summer, season-not-mentioned and disguised requests (higher is better; between $0.302$ and $0.325$ for the requests' own images, $0.19$ for images of another scene); the fraction of altered requests whose target shows the requested scene; and the fraction of the $6$ approved test prompts that the region alters, whose deployed images all remain winter scenes. The $L^2$ field region with adaptive weights was not enforced: its tuned kernel gives nearly uniform weights (an effective number of anchors of $29.6$ out of $30$).}}{39}{table.caption.80}\protected@file@percent }
\newlabel{tab:e3_enforce}{{13}{39}{Enforcement on the first evaluation split ($\ethNreqKind $ requests of each kind, $\ethP $ evaluation noises each). Each row is one region with static or adaptive weights; ``no region'' serves every request as asked. For the summer requests and for the requests without season, three columns: the fraction of requests that the region alters (that is, backs off, $\kappa >0$); their mean mixing weight $\kappa $, from $0$ (request unchanged) to $1$ (request replaced by its target), with ``--'' when no request is altered; and the fraction of their deployed images that the judge finds unsafe (lower is better). Then: the fraction of the disguised requests' deployed images judged unsafe; the mean scene similarity of the deployed images of the summer, season-not-mentioned and disguised requests (higher is better; between $\ethReqOwnSubjDis $ and $\ethReqOwnSubjNeu $ for the requests' own images, $\ethSubjOtherMH $ for images of another scene); the fraction of altered requests whose target shows the requested scene; and the fraction of the $\ethNreqApp $ approved test prompts that the region alters, whose deployed images all remain winter scenes. The $L^2$ field region with adaptive weights was not enforced: its tuned kernel gives nearly uniform weights (an effective number of anchors of $\ethNeffLtA $ out of $\ethM $)}{table.caption.80}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces What each region deploys for three requests that do not mention the season (first three rows) and for one approved test prompt (last row). The text of each request is written at the left of its row. The first column is the request's own image; each other column is the image of the field that one region deploys for the request (region and weights in the column title), all generated from the same evaluation noise, so that differences between columns come from the fields alone. The label in the lower left corner of an image gives the judge's probability of winter (red: judged unsafe) and, when the region backs the request off, the mixing weight $\kappa $; a label without $\kappa $ means that the region admits the request unchanged.}}{39}{figure.caption.81}\protected@file@percent }
\newlabel{fig:e3_gallery_neutral}{{21}{39}{What each region deploys for three requests that do not mention the season (first three rows) and for one approved test prompt (last row). The text of each request is written at the left of its row. The first column is the request's own image; each other column is the image of the field that one region deploys for the request (region and weights in the column title), all generated from the same evaluation noise, so that differences between columns come from the fields alone. The label in the lower left corner of an image gives the judge's probability of winter (red: judged unsafe) and, when the region backs the request off, the mixing weight $\kappa $; a label without $\kappa $ means that the region admits the request unchanged}{figure.caption.81}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces As Figure~\ref {fig:e3_gallery_neutral}, for two summer requests (first two rows) and two disguised requests (last two rows). In the first row, the summer pine forest is replaced by a snowy lighthouse (Mahalanobis region) or a snowy bridge (source slice, static weights), and is left a summer forest by the field regions, which mix only $\kappa =0.19$ of the target's field.}}{40}{figure.caption.82}\protected@file@percent }
\newlabel{fig:e3_gallery_summer}{{22}{40}{As Figure~\ref {fig:e3_gallery_neutral}, for two summer requests (first two rows) and two disguised requests (last two rows). In the first row, the summer pine forest is replaced by a snowy lighthouse (Mahalanobis region) or a snowy bridge (source slice, static weights), and is left a summer forest by the field regions, which mix only $\kappa =\ethPineKapSumLtS $ of the target's field}{figure.caption.82}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Enforcement map: safety against faithfulness of the deployed images (first evaluation split, $8$ requests of each kind, $8$ evaluation noises each; the numbers are those of Table~\ref {tab:e3_enforce}). Each point is one region with one weighting, with the colours, shapes and fills of Figure~\ref {fig:e3_detection}; the cross is ``no region'', the requests served as asked. Vertical axis: the fraction of the deployed images judged unsafe (lower is better). Horizontal axis: their scene similarity, the judge's cosine between each image and ``a photograph of \{scene\}'' for the requested scene (higher is better; the requests' own images score about $0.3$, images of another scene about $0.19$). The ideal region sits in the lower right corner: safe images of the requested scene. (a) Summer requests; (b) requests that do not mention the season.}}{41}{figure.caption.83}\protected@file@percent }
\newlabel{fig:e3_enforce}{{23}{41}{Enforcement map: safety against faithfulness of the deployed images (first evaluation split, $\ethNreqKind $ requests of each kind, $\ethP $ evaluation noises each; the numbers are those of Table~\ref {tab:e3_enforce}). Each point is one region with one weighting, with the colours, shapes and fills of Figure~\ref {fig:e3_detection}; the cross is ``no region'', the requests served as asked. Vertical axis: the fraction of the deployed images judged unsafe (lower is better). Horizontal axis: their scene similarity, the judge's cosine between each image and ``a photograph of \{scene\}'' for the requested scene (higher is better; the requests' own images score about $0.3$, images of another scene about $\ethSubjOtherMH $). The ideal region sits in the lower right corner: safe images of the requested scene. (a) Summer requests; (b) requests that do not mention the season}{figure.caption.83}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {11.7}What works and what does not, method by method}{41}{subsection.11.7}\protected@file@percent }
\newlabel{sec:e3_verdict}{{11.7}{41}{What works and what does not, method by method}{subsection.11.7}{}}
\@writefile{toc}{\contentsline {paragraph}{Prompt region (Euclidean distance between prompt embeddings): cheap, but blind to the season.}{41}{section*.84}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Mahalanobis region (whitened distance between prompt embeddings): excludes everything unfamiliar, safe or not.}{41}{section*.85}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Source slice (fields at the noise end): the best detector here, a poor enforcer.}{41}{section*.86}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Field region with the $L^2$ map metric (the method as written): the best enforcer, a weak detector.}{42}{section*.87}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Field region with the truncated map metric: as the $L^2$ field region.}{42}{section*.88}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Static and adaptive weights: adaptive weights trade false alarms for detection.}{42}{section*.89}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Enforcement by back-off: it keeps the scene only when the distance sees it, and it stops at the boundary.}{42}{section*.90}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Certificates: valid, but vacuous in a general-purpose feature space.}{42}{section*.91}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {11.8}Combining prompt-side decisions with field-side repairs}{42}{subsection.11.8}\protected@file@percent }
\newlabel{sec:e3_combined}{{11.8}{42}{Combining prompt-side decisions with field-side repairs}{subsection.11.8}{}}
\@writefile{toc}{\contentsline {paragraph}{Three ways to combine two distances.}{43}{section*.92}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{What conformal prediction guarantees.}{43}{section*.93}\protected@file@percent }
