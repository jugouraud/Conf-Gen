\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces What the new methods deploy for the requests of Figure~\ref {fig:e3_gallery_neutral}: three requests that do not mention the season (first three rows) and one approved test prompt (last row). The text of each request is at the left of its row. The first column is the request's own image; the next two are the deployed images of the previous source-slice and field regions (static), and the others those of the new methods named in the column titles, all generated from the same evaluation noise. The label in the lower left corner of an image gives the judge's probability of winter (red: judged unsafe) and, when the method backs the request off, the mixing weight $\kappa $; a label without $\kappa $ means that the request is admitted unchanged. What to notice: in the first row, the previous source slice turns the pine forest into a snowy bridge, and only slice$\to $field, local and Mahalanobis$\to $field turn it into a snowy pine forest; in the second row, field, deep and joint$\to $field, deep turn the stone bridge into a river valley, while slice$\to $field, local keeps a snowy bridge; in the third row, slice$\to $field alone leaves the farmhouse in summer; the approved prompt of the last row is left unchanged by every method.}}{49}{figure.caption.103}\protected@file@percent }
\newlabel{fig:e3c_gallery_neutral}{{26}{49}{What the new methods deploy for the requests of Figure~\ref {fig:e3_gallery_neutral}: three requests that do not mention the season (first three rows) and one approved test prompt (last row). The text of each request is at the left of its row. The first column is the request's own image; the next two are the deployed images of the previous source-slice and field regions (static), and the others those of the new methods named in the column titles, all generated from the same evaluation noise. The label in the lower left corner of an image gives the judge's probability of winter (red: judged unsafe) and, when the method backs the request off, the mixing weight $\kappa $; a label without $\kappa $ means that the request is admitted unchanged. What to notice: in the first row, the previous source slice turns the pine forest into a snowy bridge, and only slice$\to $field, local and Mahalanobis$\to $field turn it into a snowy pine forest; in the second row, field, deep and joint$\to $field, deep turn the stone bridge into a river valley, while slice$\to $field, local keeps a snowy bridge; in the third row, slice$\to $field alone leaves the farmhouse in summer; the approved prompt of the last row is left unchanged by every method}{figure.caption.103}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces As Figure~\ref {fig:e3c_gallery_neutral}, for the two summer requests (first two rows) and the two disguised requests (last two rows) of Figure~\ref {fig:e3_gallery_summer}. What to notice: the summer pine forest stays a summer forest with the field region, before and after deep back-off (a central scene is barely excluded and barely mixed), and becomes a snowy pine forest with slice$\to $field, local; the summer mountain village becomes a snowy mountain lake with field, deep and joint$\to $field, deep, and a snowy mountain village with slice$\to $field, local; the two disguised requests, whose own images are already wintry, are admitted by every method that decides with the source slice or with the joint score, while the field regions alter the lighthouse and Mahalanobis$\to $field mixes both heavily ($\kappa \approx 0.75$).}}{49}{figure.caption.104}\protected@file@percent }
\newlabel{fig:e3c_gallery_summer}{{27}{49}{As Figure~\ref {fig:e3c_gallery_neutral}, for the two summer requests (first two rows) and the two disguised requests (last two rows) of Figure~\ref {fig:e3_gallery_summer}. What to notice: the summer pine forest stays a summer forest with the field region, before and after deep back-off (a central scene is barely excluded and barely mixed), and becomes a snowy pine forest with slice$\to $field, local; the summer mountain village becomes a snowy mountain lake with field, deep and joint$\to $field, deep, and a snowy mountain village with slice$\to $field, local; the two disguised requests, whose own images are already wintry, are admitted by every method that decides with the source slice or with the joint score, while the field regions alter the lighthouse and Mahalanobis$\to $field mixes both heavily ($\kappa \approx 0.75$)}{figure.caption.104}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Unfamiliar requests (first evaluation split, $8$ requests of each kind, $8$ evaluation noises each). Each row is one method: first the previous regions with static weights, then the new methods (the projection was not run on these requests). For the paraphrases and the winter requests of new scenes, which are safe: the fraction of requests that the method alters, that is, its false alarms (lower is better); the mean \emph  {image change}, the $\chi $-distance between each deployed image and the request's own image on the same noise, $0$ for an admitted request (lower is better; for scale, $0.37$ between two approved prompts of the same scene and $0.71$ between two scenes); and the fraction of deployed images judged unsafe. For the summer requests of new scenes, which are unsafe and have no approved prompt of their scene: the fraction altered (higher is better), the fraction of deployed images judged unsafe (lower is better), and their scene similarity (higher is better).}}{50}{table.caption.106}\protected@file@percent }
\newlabel{tab:e3c_unfamiliar}{{17}{50}{Unfamiliar requests (first evaluation split, $\ethcNunf $ requests of each kind, $\ethP $ evaluation noises each). Each row is one method: first the previous regions with static weights, then the new methods (the projection was not run on these requests). For the paraphrases and the winter requests of new scenes, which are safe: the fraction of requests that the method alters, that is, its false alarms (lower is better); the mean \emph {image change}, the $\chi $-distance between each deployed image and the request's own image on the same noise, $0$ for an admitted request (lower is better; for scale, $\ethcChgSame $ between two approved prompts of the same scene and $\ethcChgOther $ between two scenes); and the fraction of deployed images judged unsafe. For the summer requests of new scenes, which are unsafe and have no approved prompt of their scene: the fraction altered (higher is better), the fraction of deployed images judged unsafe (lower is better), and their scene similarity (higher is better)}{table.caption.106}{}}
