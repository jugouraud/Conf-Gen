\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Order-$1$ regions of linear flow-matching fields on the toy (means over $100$ splits for the ODE costs and $200$ for the SDE costs). Exclusion: fraction of contaminated fields of unsafe mass $m$ outside the region. Certificate: median over splits of the bound on $P(A)$ that holds for every field of the region (plug-in, with a $95\%$ Clopper--Pearson bound on $\bar  P_w(A)$, Remark~\ref {rem:mc}), against the largest $P(A)$ of a held-out or contaminated field inside the region (median and maximum over splits). No split violates its bound. Safe fields have $P(A)=0.0017$ (ODE) and $0.0004$ (SDE). The Clopper--Pearson bound treats the indicators of the $M$ safe samplers as independent, although they share their noise chains, so it is slightly anti-conservative. The two on-policy rows agree to two decimals by coincidence: at $m=0.01$ and $0.03$ they exclude $0.133$ and $0.552$ ($G_{\mathrm  {on}}$) against $0.129$ and $0.546$ (reverse KL).}}{14}{table.caption.15}\protected@file@percent }
\newlabel{tab:regions}{{2}{14}{Order-$1$ regions of linear flow-matching fields on the toy (means over $100$ splits for the ODE costs and $200$ for the SDE costs). Exclusion: fraction of contaminated fields of unsafe mass $m$ outside the region. Certificate: median over splits of the bound on $P(A)$ that holds for every field of the region (plug-in, with a $95\%$ Clopper--Pearson bound on $\bar P_w(A)$, Remark~\ref {rem:mc}), against the largest $P(A)$ of a held-out or contaminated field inside the region (median and maximum over splits). No split violates its bound. Safe fields have $P(A)=\pALCmean $ (ODE) and $\pALDmean $ (SDE). The Clopper--Pearson bound treats the indicators of the $M$ safe samplers as independent, although they share their noise chains, so it is slightly anti-conservative. The two on-policy rows agree to two decimals by coincidence: at $m=0.01$ and $0.03$ they exclude $\exclCononeP $ and $\exclConthreeP $ ($G_{\mathrm {on}}$) against $\exclDrevoneP $ and $\exclDrevthreeP $ (reverse KL)}{table.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Fraction of contaminated fields outside the region against their unsafe mass. (a) Diffusion with exact scores (POC pilot A), which isolates the choice of cost: forward $\sqrt  {2\mathrm  {KL}}$ (blue), reverse $\mathrm  {KL}$ (orange) and reverse $\sqrt  {2\mathrm  {KL}}$ (green). (b) Linear flow matching, ODE: $d_{\bar  \rho }$ (blue) and $G_{\mathrm  {on}}$ (orange). (c) Linear flow matching, SDE: forward (blue) and reverse (orange) $\mathrm  {KL}$. Grey: fraction of held-out safe fields outside the region ($1-$coverage).}}{14}{figure.caption.16}\protected@file@percent }
\newlabel{fig:exclusion}{{2}{14}{Fraction of contaminated fields outside the region against their unsafe mass. (a) Diffusion with exact scores (POC pilot A), which isolates the choice of cost: forward $\sqrt {2\KL }$ (blue), reverse $\KL $ (orange) and reverse $\sqrt {2\KL }$ (green). (b) Linear flow matching, ODE: $d_{\bar \rho }$ (blue) and $G_{\mathrm {on}}$ (orange). (c) Linear flow matching, SDE: forward (blue) and reverse (orange) $\KL $. Grey: fraction of held-out safe fields outside the region ($1-$coverage)}{figure.caption.16}{}}
